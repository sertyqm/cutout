# Uses a pinned, reviewed snapshot of the default model.
CUTOUT_MODEL_ID=ZhengPeng7/BiRefNet_HR-matting
CUTOUT_MODEL_REVISION=5d6b6f8adcb5b417c871b1d84ceaae9871355b7f

# auto selects CUDA when available, otherwise CPU. CPU works but is slow at 2048px.
CUTOUT_DEVICE=auto
CUTOUT_INPUT_SIZE=2048
CUTOUT_USE_HALF_PRECISION=true
CUTOUT_MAX_UPLOAD_BYTES=15728640
CUTOUT_MAX_IMAGE_PIXELS=24000000
